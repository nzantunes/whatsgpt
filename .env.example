# Chaves de IA (obrigatório pelo menos uma)
OPENAI_API_KEY=sk-...
GROK_API_KEY=xai-...
# Ou use XAI_API_KEY em vez de GROK_API_KEY

# Servidor
PORT=3000
SESSION_SECRET=altere-para-uma-string-segura
BASE_URL=http://localhost:3000

# Pastas (opcional)
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Chromium para QR Code do WhatsApp
CHROMIUM_PATH=/usr/bin/chromium
