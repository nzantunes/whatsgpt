# Porta do servidor (3002 se 3001 estiver em uso)
PORT=3002

# Chave secreta para sessões (altere em produção)
SESSION_SECRET=change-this-session-secret

# API Keys (obrigatório configurar)
OPENAI_API_KEY=your-openai-api-key
GROK_API_KEY=your-grok-api-key


# URL base (localhost ou URL pública como ngrok)
BASE_URL=http://localhost:3002

# Chromium/Chrome para WhatsApp Web
# true: usa Chromium do Puppeteer
# false: usa executável definido em CHROMIUM_PATH
USE_BUNDLED_CHROMIUM=false
CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Cache do Puppeteer
PUPPETEER_CACHE_DIR=.puppeteer-cache

# Diretórios de dados
DATA_DIR=./data
UPLOADS_DIR=./uploads


