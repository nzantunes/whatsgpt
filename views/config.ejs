<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Configuração do Bot — WhatsGPT</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <header class="header">
      <a href="/" class="logo">WhatsGPT</a>
      <nav>
        <a href="/config">Configuração</a>
        <a href="/qrcode">QR Code</a>
        <a href="/logout">Sair</a>
      </nav>
    </header>
    <main class="main">
      <div class="card">
        <h1>Configuração do Bot</h1>
        <% if (!phone) { %>
          <p class="warning">Conecte seu WhatsApp em <a href="/qrcode">QR Code</a> para configurar o bot.</p>
        <% } else { %>
          <p class="phone">Número conectado: <strong><%= phone %></strong></p>
          <p class="warning">Para o bot responder no WhatsApp: (1) crie uma configuração, (2) clique em <strong>Ativar</strong> nela. Só uma configuração pode estar ativa por vez.</p>
          <h2>Configurações (perfis)</h2>
          <ul id="config-list" class="config-list">
            <% configs.forEach(c => { %>
              <li data-id="<%= c.id %>">
                <span class="name"><%= c.name %></span>
                <% if (c.isActive) { %><span class="badge active">Ativa</span><% } %>
                <button type="button" class="btn btn-sm edit-config" data-id="<%= c.id %>">Editar</button>
                <button type="button" class="btn btn-sm btn-danger delete-config" data-id="<%= c.id %>">Excluir</button>
                <% if (!c.isActive) { %><button type="button" class="btn btn-sm activate-config" data-id="<%= c.id %>">Ativar</button><% } %>
              </li>
            <% }); %>
          </ul>
          <button type="button" id="new-config" class="btn">Nova configuração</button>
        <% } %>
      </div>

      <div id="modal" class="modal" style="display: none;">
        <div class="modal-content card">
          <h2 id="modal-title">Editar configuração</h2>
          <form id="config-form" class="form">
            <input type="hidden" name="id" id="config-id">
            <label>Nome <input type="text" name="name" id="config-name" required></label>
            <label>Prompt do sistema <textarea name="systemPrompt" id="config-systemPrompt" rows="4"></textarea></label>
            <label>Modelo
              <select name="model" id="config-model">
                <option value="gpt-3.5-turbo">gpt-3.5-turbo</option>
                <option value="gpt-4">gpt-4</option>
                <option value="gpt-4o">gpt-4o</option>
                <option value="gpt-4-turbo">gpt-4-turbo</option>
                <option value="grok-2">grok-2 (xAI, usa grok-4)</option>
                <option value="grok-4">grok-4 (xAI)</option>
                <option value="grok-2-1212">grok-2-1212 (descontinuado → usa grok-3)</option>
                <option value="grok-beta">grok-beta (xAI)</option>
                <option value="automation-agent">🤖 Agente de Automação (Cursor)</option>
              </select>
            </label>
            <label>Informações adicionais <textarea name="additionalInfo" id="config-additionalInfo" rows="2"></textarea></label>
            <label>URLs (uma por linha) <textarea name="urls" id="config-urls" rows="2" placeholder="https://..."></textarea></label>
            <label>Arquivos anexados (base de conhecimento)</label>
            <div id="config-files" class="config-files-pilhas"></div>
            <label>Upload de arquivo (PDF, XLSX, CSV) <input type="file" id="config-file-input" accept=".pdf,.xlsx,.xls,.csv"></label>
            <div class="form-actions">
              <button type="submit" class="btn">Salvar</button>
              <button type="button" id="modal-close" class="btn btn-secondary">Fechar</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card">
        <h2>🤖 Agente de Automação</h2>
        <p class="hint" style="margin-bottom: 10px;">Modelo de IA que interpreta o que o usuário quer e controla o agente (abrir navegador, pesquisar, YouTube, etc.).</p>
        <label>Modelo para interpretar comandos
          <select id="agent-model">
            <option value="gpt-4o">GPT-4o (OpenAI)</option>
            <option value="gpt-4">GPT-4 (OpenAI)</option>
            <option value="gpt-3.5-turbo">GPT-3.5 Turbo (OpenAI)</option>
            <option value="grok-4">Grok-4 (xAI)</option>
            <option value="grok-2">Grok-2 (xAI)</option>
            <option value="grok-3">Grok-3 (xAI)</option>
            <option value="grok-beta">Grok Beta (xAI)</option>
          </select>
        </label>
        <button type="button" id="save-agent-config" class="btn" style="margin-top: 8px;">Salvar modelo do agente</button>
        <p id="agent-config-msg" class="hint" style="margin-top: 6px; font-size: 12px;"></p>
      </div>

      <div class="card test-card">
        <h2>Testar resposta (sem enviar no WhatsApp)</h2>
        <select id="test-config-id">
          <option value="">Configuração ativa (mesma do WhatsApp)</option>
          <% configs.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }); %>
        </select>
        <textarea id="test-message" placeholder="Digite uma mensagem de teste..." rows="2"></textarea>
        <button type="button" id="test-gpt" class="btn">Enviar teste</button>
        <pre id="test-result" class="test-result"></pre>
      </div>

      <!-- Seção de teste de vídeo removida - funcionalidade desabilitada -->
    </main>
  </div>
  <script src="/js/config.js"></script>
</body>
</html>
