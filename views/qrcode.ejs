<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Conectar WhatsApp — WhatsNain</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <header class="header">
      <a href="/" class="logo">WhatsNain</a>
      <nav>
        <% if (typeof phone !== 'undefined' && phone) { %><a href="/config">Configuração</a><% } %>
        <a href="/qrcode">QR Code</a>
        <a href="/logout">Sair</a>
      </nav>
    </header>
    <main class="main">
      <div class="card qrcode-card">
        <h1>Conectar WhatsApp</h1>
        <p><strong>Um QR Code por usuário:</strong> Cada usuário cadastrado (cada conta) tem seu próprio QR Code. O QR que aparece aqui é exclusivo da sua conta — outro usuário logado em outra conta verá outro QR. Vincule o número ao fazer login nesta conta.</p>
        <p><strong>Obrigatório:</strong> Escaneie o QR Code com o WhatsApp no celular (WhatsApp → Dispositivos vinculados → Vincular dispositivo) para liberar a página Configuração. A configuração do bot é salva por número.</p>
        <div id="qrcode-container">
          <img id="qrcode-img" alt="QR Code" style="display: none;">
          <canvas id="qrcode-canvas" style="display: none;"></canvas>
          <p id="qrcode-wait">Gerando QR Code...</p>
          <p id="qrcode-read-hint" style="margin-top: 0.5rem; color: #94a3b8; font-size: 0.92rem;">
            Após a leitura do QR Code, você será direcionado automaticamente. Aguarde um momento.
          </p>
          <div id="qrcode-redirect-loading" style="display: none; margin-top: 0.75rem; padding: 0.75rem; border-radius: 8px; background: #0f172a; color: #e2e8f0; border: 1px solid #334155;">
            <strong>QR lido com sucesso.</strong><br>
            Aguarde um momento... estamos finalizando a conexão e você será direcionado automaticamente.
          </div>
          <div id="qrcode-ready" style="display: none;">
            <p id="qrcode-ready-msg">Conectado.</p>
            <p id="qrcode-status-connected" class="status"></p>
            <button type="button" id="btn-vincular" class="btn btn-primary">Vincular à minha conta</button>
            <button type="button" id="btn-desconectar" class="btn btn-secondary" style="margin-left: 0.5em;">Desconectar e gerar novo QR</button>
            <p id="qrcode-vincular-erro" class="qrcode-error" style="display: none; margin-top: 0.5em;"></p>
          </div>
          <div id="qrcode-error" class="qrcode-error" style="display: none;"></div>
        </div>
        <p id="qrcode-status" class="status"></p>
      </div>
    </main>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    // If `roomToken` was provided by server, connect socket with that room query
    <% if (typeof roomToken !== 'undefined' && roomToken) { %>
      const ROOM_TOKEN = '<%= roomToken %>';
      const socket = io({ query: { room: ROOM_TOKEN } });
    <% } else { %>
      const socket = io();
    <% } %>
    const img = document.getElementById('qrcode-img');
    const wait = document.getElementById('qrcode-wait');
    const ready = document.getElementById('qrcode-ready');
    const statusEl = document.getElementById('qrcode-status');
    const statusConnected = document.getElementById('qrcode-status-connected');
    const btnVincular = document.getElementById('btn-vincular');
    const btnDesconectar = document.getElementById('btn-desconectar');
    const vincularErro = document.getElementById('qrcode-vincular-erro');
    const redirectLoading = document.getElementById('qrcode-redirect-loading');

    function showRedirectLoading() {
      if (redirectLoading) redirectLoading.style.display = 'block';
    }

    function hideRedirectLoading() {
      if (redirectLoading) redirectLoading.style.display = 'none';
    }

    function showConectado(msg, isSessaoSalva) {
      wait.style.display = 'none';
      document.getElementById('qrcode-error').style.display = 'none';
      ready.style.display = 'block';
      if (isSessaoSalva) hideRedirectLoading();
      if (statusConnected) {
        if (isSessaoSalva) {
          statusConnected.innerHTML = (msg || '') + '<br><small>Conectado pela sessão salva (você não escaneou o QR agora). Use "Desconectar" para escanear outro número.</small>';
        } else {
          statusConnected.textContent = msg || '';
        }
      }
      if (vincularErro) vincularErro.style.display = 'none';
    }

    function vincularConta() {
      if (!btnVincular) return;
      btnVincular.disabled = true;
      if (vincularErro) vincularErro.style.display = 'none';
      iniciarTimerAtualizarPagina();
      chamarSetPhone(0);
    }

    let timerRedirectMsg = null;

    function chamarSetPhone(tentativa) {
      const maxTentativas = 20;
      const delayMs = 600;
      showRedirectLoading();
      fetch('/api/set-phone', { method: 'POST', credentials: 'same-origin' })
        .then(r => r.json())
        .then((d) => {
          if (timerRedirectMsg) { clearTimeout(timerRedirectMsg); timerRedirectMsg = null; }
          if (btnVincular) btnVincular.disabled = false;
          if (d.code === 'PHONE_TAKEN') {
            hideRedirectLoading();
            if (statusConnected) statusConnected.textContent = '';
            if (vincularErro) { vincularErro.textContent = d.error || 'Este número já está vinculado a outra conta.'; vincularErro.style.display = 'block'; }
            return;
          }
          if (d.ok) {
            window.location.href = '/config';
            return;
          }
          if (d.error && d.error.includes('ainda não conectado') && tentativa < maxTentativas) {
            setTimeout(function () { chamarSetPhone(tentativa + 1); }, delayMs);
            return;
          }
          hideRedirectLoading();
          if (d.error && tentativa >= maxTentativas - 1 && statusConnected) {
            statusConnected.innerHTML = 'O celular conectou; o sistema pode demorar alguns segundos para detectar. Clique em <strong>Vincular à minha conta</strong> de novo ou atualize a página (F5) e tente novamente.';
          }
        })
        .catch(function () {
          if (timerRedirectMsg) { clearTimeout(timerRedirectMsg); timerRedirectMsg = null; }
          if (btnVincular) btnVincular.disabled = false;
          hideRedirectLoading();
        });
    }

    function iniciarTimerAtualizarPagina() {
      if (timerRedirectMsg) clearTimeout(timerRedirectMsg);
      timerRedirectMsg = setTimeout(function () {
        timerRedirectMsg = null;
        if (statusConnected) {
          statusConnected.innerHTML = 'Não foi possível redirecionar. <strong>Atualize a página (F5) e tente novamente.</strong>';
        }
      }, 5000);
    }

    if (btnVincular) btnVincular.addEventListener('click', vincularConta);

    socket.on('qrcode', (data) => {
      const errEl = document.getElementById('qrcode-error');
      if (data.error) {
        wait.style.display = 'none';
        errEl.style.display = 'block';
        const msg = (data.message || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        errEl.innerHTML = '<strong>Navegador não iniciou / QR não apareceu a tempo.</strong><br><br>' + msg +
          '<br><br><strong>Windows:</strong> Rode o servidor fora do Cursor (PowerShell: <code>cd pasta_do_projeto; npm start</code>). No .env: <code>CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe</code> e <code>USE_BUNDLED_CHROMIUM=false</code>.' +
          '<br><br><strong>Linux:</strong> <code>sudo apt install chromium-browser</code> e no .env: <code>CHROMIUM_PATH=/usr/bin/chromium</code>. Atualize a página (F5) para tentar de novo.';
        return;
      }
      errEl.style.display = 'none';
      if (data.ready) {
        wait.style.display = 'none';
        document.getElementById('qrcode-error').style.display = 'none';
        ready.style.display = 'block';
        showConectado('Conectado. Vinculando…', false);
        iniciarTimerAtualizarPagina();
        chamarSetPhone(0);
        return;
      }
      if (data.url) {
        img.src = data.url;
        img.style.display = 'block';
        wait.style.display = 'none';
      }
    });

    socket.on('connected', (data) => {
      showConectado('Número: ' + (data.phone ? data.phone.replace(/.(?=.{4})/g, '*') : '') + ' — Vinculando ao sistema…', false);
      iniciarTimerAtualizarPagina();
      chamarSetPhone(0);
    });

    socket.on('phone_taken', (data) => {
      wait.style.display = 'none';
      ready.style.display = 'none';
      hideRedirectLoading();
      if (timerRedirectMsg) { clearTimeout(timerRedirectMsg); timerRedirectMsg = null; }
      const errEl = document.getElementById('qrcode-error');
      errEl.style.display = 'block';
      errEl.textContent = (data && data.error) || 'Este número já está vinculado a outra conta. Use outro número ou peça ao dono para desvincular.';
      if (vincularErro) {
        vincularErro.textContent = errEl.textContent;
        vincularErro.style.display = 'block';
      }
      if (statusConnected) statusConnected.textContent = '';
      if (btnVincular) btnVincular.disabled = false;
    });

    socket.on('auth_failure', () => { statusEl.textContent = 'Falha na autenticação.'; });
    socket.on('disconnected', (d) => { statusEl.textContent = 'Desconectado: ' + (d.reason || ''); });

    fetch('/api/qrcode-status')
      .then(r => r.json())
      .then((s) => {
        if (s.browserError) {
          wait.style.display = 'none';
          const errEl = document.getElementById('qrcode-error');
          errEl.style.display = 'block';
          var baseUrl = window.location.origin || ('http://localhost:' + (window.location.port || '3000'));
            errEl.innerHTML = '<strong>Navegador não iniciou.</strong><br><br>' + s.browserError +
            '<br><br><strong>Se ainda não resolver (Windows):</strong> No .env use <code>CHROMIUM_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe</code> e <code>USE_BUNDLED_CHROMIUM=false</code>.<br>' +
            '<strong>Linux:</strong> <code>sudo apt install chromium-browser</code> e no .env: <code>CHROMIUM_PATH=/usr/bin/chromium</code>. Acesse <a href="' + baseUrl + '">' + baseUrl + '</a> após iniciar.';
          return;
        }
        if (s.ready && s.phone) {
          if (s.phoneTaken) {
            wait.style.display = 'none';
            hideRedirectLoading();
            const errEl = document.getElementById('qrcode-error');
            errEl.style.display = 'block';
            errEl.textContent = 'Este número já está vinculado a outra conta. Use outro número ou peça ao dono para desvincular.';
            return;
          }
          showConectado('Já conectado com o número ' + (s.phone ? s.phone.replace(/.(?=.{4})/g, '*') : '') + ' (sessão salva).', true);
          if (btnDesconectar) {
            btnDesconectar.onclick = function () {
              btnDesconectar.disabled = true;
              fetch('/api/whatsapp-disconnect', { method: 'POST', credentials: 'same-origin' })
                .then(function () { window.location.reload(); })
                .catch(function () { btnDesconectar.disabled = false; });
            };
          }
          return;
        }
      })
      .catch(function () {
        wait.style.display = 'none';
        document.getElementById('qrcode-error').style.display = 'block';
        document.getElementById('qrcode-error').innerHTML = 'Não foi possível conectar ao servidor. <strong>Use na barra de endereço:</strong> <code><%= typeof appUrl !== "undefined" ? appUrl : "http://localhost:3000" %></code>';
      });
  </script>
</body>
</html>
