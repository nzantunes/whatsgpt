<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Recuperar Senha — WhatsNain</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background-color: #e3f2fd;
    }
    .reset-form-container {
      max-width: 400px;
      margin: 2rem auto;
    }
    .form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .form input, .form button {
      padding: 0.75rem;
      font-size: 1rem;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    .form input {
      border: 1px solid #ddd;
    }
    .form button {
      background-color: #ffa500;
      color: #fff;
      border: none;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.3s;
    }
    .form button:hover {
      background-color: #ff8c00;
    }
    .form button:disabled {
      background-color: #ccc;
      cursor: not-allowed;
    }
    .error {
      color: #d32f2f;
      padding: 1rem;
      background-color: #ffebee;
      border: 1px solid #ffcdd2;
      border-radius: 4px;
      margin: 1rem 0;
    }
    .success {
      color: #388e3c;
      padding: 1rem;
      background-color: #e8f5e9;
      border: 1px solid #c8e6c9;
      border-radius: 4px;
      margin: 1rem 0;
    }
    .loading {
      text-align: center;
      padding: 2rem;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #f3f3f3;
      border-top: 4px solid #ffa500;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 0 auto 1rem;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }
    .loading-overlay.hidden {
      display: none;
    }
    .loading-content {
      background: white;
      padding: 2rem;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .loading-content .spinner {
      margin-bottom: 1rem;
    }
    .loading-content p {
      color: #333;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <!-- Loading Overlay -->
  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-content">
      <div class="spinner"></div>
      <p>Carregando...</p>
    </div>
  </div>
  <div class="app">
    <header class="header">
      <a href="/" class="logo">WhatsNain</a>
      <nav>
        <a href="/login">Voltar ao Login</a>
      </nav>
    </header>
    <main class="main">
      <div class="card reset-form-container">
        <h1>Recuperar Senha</h1>
        
        <!-- QR scanning phase -->
        <div id="qr-phase" style="display: block;">
          <p><strong>Escaneie este QR com o WhatsApp no seu celular:</strong></p>
          <p style="font-size: 0.9rem; color: #666;">Acesse WhatsApp → Dispositivos vinculados → Vincular dispositivo e aponte a câmera para o QR code abaixo.</p>
          
          <div id="qrcode-container" style="text-align: center; padding: 2rem 0;">
            <div id="qrcode-wait" class="loading">
              <div class="spinner"></div>
              <p>Gerando QR Code...</p>
              <p style="margin-top: 0.45rem; color: #64748b; font-size: 0.92rem;">
                Após a leitura do QR Code, você será direcionado automaticamente. Aguarde um momento.
              </p>
            </div>
            <canvas id="qrcode-canvas" style="display: none; max-width: 300px; border: 2px solid #ffa500; padding: 1rem; background: #fff;"></canvas>
            <div id="qrcode-error" class="error" style="display: none;"></div>
            <button id="btn-atualizar-qr" type="button" style="display: none; margin-top: 1rem; background-color: #ffa500;" class="btn btn-warning">Atualizar Página</button>
          </div>
          
          <div id="detection-wait" style="display: none; text-align: center; margin-top: 2rem;">
            <div class="spinner"></div>
            <p><strong>QR lido com sucesso.</strong><br>Aguarde um momento... estamos verificando seu número e você será direcionado automaticamente para a próxima etapa.</p>
          </div>
          
          <p style="font-size: 0.9rem; color: #666; margin-top: 1rem;"><strong>Importante:</strong> Use o mesmo número de WhatsApp registrado na sua conta.</p>
        </div>
        
        <!-- Password reset form phase -->
        <div id="reset-form-phase" style="display: none;">
          <div id="user-info" style="padding: 1rem; background-color: #1976d2; border-radius: 4px; margin-bottom: 1rem; border: 2px solid #1565c0; color: white;">
            <p><strong>Usuário:</strong> <span id="username-display">-</span></p>
            <p><strong>Telefone:</strong> <span id="phone-display">-</span></p>
          </div>
          
          <form id="password-form" class="form">
            <label>
              <strong>Nova Senha</strong>
              <input type="password" name="password" required minlength="6" placeholder="Mínimo 6 caracteres">
            </label>
            <label>
              <strong>Confirmar Senha</strong>
              <input type="password" name="confirm" required minlength="6" placeholder="Confirmar senha">
            </label>
            <button type="submit" style="background-color: #ffa500;">Redefinir Senha</button>
          </form>
          
          <div id="reset-message" style="margin-top: 1rem;"></div>
        </div>
      </div>
    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    // Hide loading overlay when page is ready
    function hideLoadingOverlay() {
      const overlay = document.getElementById('loading-overlay');
      if (overlay) {
        overlay.classList.add('hidden');
      }
    }

    // Hide overlay after a short delay to ensure page is rendered
    window.addEventListener('load', hideLoadingOverlay);
    setTimeout(hideLoadingOverlay, 1000);

    const roomId = 'reset-' + (Math.random().toString(36).substr(2, 9));
    console.log('[Password Reset QR] Room ID:', roomId);
    console.log('[Password Reset QR] Connecting socket with room query...');
    const socket = io({ query: { room: roomId } });
    
    socket.on('connect', () => {
      console.log('[Password Reset QR] ✓ Socket conectado:', socket.id);
      console.log('[Password Reset QR] Room ID:', roomId);
      console.log('[Password Reset QR] Esperando eventos de QR ou conexão...');
    });
    
    socket.on('disconnect', (reason) => {
      console.log('[Password Reset QR] ✗ Socket desconectado:', reason);
    });
    
    socket.on('error', (error) => {
      console.error('[Password Reset QR] ✗ Socket erro:', error);
    });
    
    let connectedPhone = null;
    let connectedUsername = null;
    let connectedUserId = null;
    
    // QR Code generation
    const qrcodeCanvas = document.getElementById('qrcode-canvas');
    const qrcodeWait = document.getElementById('qrcode-wait');
    const qrcodeError = document.getElementById('qrcode-error');
    const btnAtualizar = document.getElementById('btn-atualizar-qr');

    // Show error with update button
    function showErrorWithButton(errorMsg) {
      qrcodeWait.style.display = 'none';
      qrcodeError.style.display = 'block';
      qrcodeError.className = 'error';
      qrcodeError.innerHTML = errorMsg;
      btnAtualizar.style.display = 'block';
    }

    // Handle update button
    if (btnAtualizar) {
      btnAtualizar.addEventListener('click', () => {
        location.reload();
      });
    }

    socket.on('qrcode', (data) => {
      console.log('[Password Reset QR] Evento qrcode recebido:', data);
      if (data.error) {
        showErrorWithButton('<strong>Erro ao gerar QR:</strong> ' + (data.message || 'Tente novamente'));
        return;
      }
      
      if (data.url) {
        const img = new Image();
        img.onload = function() {
          const ctx = qrcodeCanvas.getContext('2d');
          qrcodeCanvas.width = img.width;
          qrcodeCanvas.height = img.height;
          ctx.drawImage(img, 0, 0);
          qrcodeWait.style.display = 'none';
          qrcodeCanvas.style.display = 'block';
          btnAtualizar.style.display = 'block';
          console.log('[Password Reset QR] QR code displayed');
        };
        img.src = data.url;
      }
    });

    socket.on('connected', async (data) => {
      connectedPhone = data.phone;
      console.log('[Password Reset QR] Phone connected event received:', connectedPhone);
      console.log('[Password Reset QR] Data received:', data);
      
      // Hide QR, show detection message
      document.getElementById('qr-phase').style.display = 'none';
      document.getElementById('detection-wait').style.display = 'block';
      console.log('[Password Reset QR] Showing detection wait, hiding QR phase');
      
      // Check if phone is registered
      try {
        console.log('[Password Reset QR] Fetching check-phone for phone:', connectedPhone);
        const res = await fetch('/api/password-reset/check-phone', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone: connectedPhone })
        });
        
        console.log('[Password Reset QR] check-phone response status:', res.status);
        
        if (res.ok) {
          const data = await res.json();
          console.log('[Password Reset QR] check-phone success:', data);
          connectedUsername = data.username;
          connectedUserId = data.userId;
          
          // Show reset form
          document.getElementById('detection-wait').style.display = 'none';
          document.getElementById('reset-form-phase').style.display = 'block';
          document.getElementById('username-display').textContent = connectedUsername;
          document.getElementById('phone-display').textContent = connectedPhone;
          console.log('[Password Reset QR] Form shown with username:', connectedUsername);
        } else {
          const data = await res.json().catch(() => ({ error: 'Resposta inválida do servidor' }));
          console.log('[Password Reset QR] check-phone error:', data);
          document.getElementById('detection-wait').style.display = 'none';
          showErrorWithButton('<strong>Erro:</strong> ' + (data.error || 'Telefone não registrado'));
          document.getElementById('qr-phase').style.display = 'block';
        }
      } catch (err) {
        console.error('[Password Reset QR] Exception:', err);
        document.getElementById('detection-wait').style.display = 'none';
        showErrorWithButton('<strong>Erro de conexão:</strong> Tente novamente');
        document.getElementById('qr-phase').style.display = 'block';
      }
    });

    socket.on('auth_failure', () => {
      showErrorWithButton('<strong>Falha na autenticação:</strong> Tente escanear o QR novamente');
    });

    // Fetch initial QR
    fetch('/api/qrcode-status?room=' + encodeURIComponent(roomId))
      .then(r => r.json())
      .then(s => {
        if (s.browserError) {
          showErrorWithButton('<strong>Erro do navegador:</strong> ' + s.browserError);
        }
      });

    // Password reset form submission
    document.getElementById('password-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const password = e.target.password.value;
      const confirm = e.target.confirm.value;
      
      if (password !== confirm) {
        alert('As senhas não correspondem');
        return;
      }
      
      const btn = e.target.querySelector('button');
      btn.disabled = true;
      
      try {
        const res = await fetch('/api/password-reset/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: connectedUserId,
            newPassword: password
          })
        });
        
        const data = await res.json();
        
        if (res.ok) {
          document.getElementById('reset-message').innerHTML = '<div class="success"><strong>✓ Senha redefinida com sucesso!</strong><br><br>Aguarde um momento... você será direcionado automaticamente para a configuração.</div>';
          setTimeout(() => {
            window.location.href = data.redirectTo || '/config';
          }, 2000);
        } else {
          document.getElementById('reset-message').innerHTML = '<div class="error"><strong>Erro:</strong> ' + (data.error || 'Falha ao redefinir senha') + '</div>';
          btn.disabled = false;
        }
      } catch (err) {
        console.error('Error:', err);
        document.getElementById('reset-message').innerHTML = '<div class="error"><strong>Erro:</strong> Falha na conexão</div>';
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
