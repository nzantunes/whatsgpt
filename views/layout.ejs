<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'WhatsNain' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <header class="header">
      <a href="/" class="logo">WhatsNain</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <nav>
          <a href="/config">Configuração</a>
          <a href="/qrcode">QR Code</a>
          <a href="/logout">Sair</a>
        </nav>
      <% } %>
    </header>
    <main class="main">
      <%- body %>
    </main>
  </div>
  <script src="/js/common.js"></script>
  <% if (typeof scripts !== 'undefined' && scripts) { %><%- scripts %><% } %>
</body>
</html>
