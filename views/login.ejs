<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login — WhatsNain</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }
    .loading-overlay.hidden {
      display: none;
    }
    .loading-content {
      background: white;
      padding: 2rem;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #f3f3f3;
      border-top: 4px solid #ffa500;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 0 auto 1rem;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .loading-content p {
      color: #333;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <!-- Loading Overlay -->
  <div id="loading-overlay" class="loading-overlay hidden">
    <div class="loading-content">
      <div class="spinner"></div>
      <p>Carregando...</p>
    </div>
  </div>
  <div class="app login-page">
    <header class="header">
      <a href="/" class="logo">WhatsNain</a>
    </header>
    <main class="main">
      <div class="card login-card">
        <h1>Entrar</h1>
        <% if (typeof updated !== 'undefined' && updated) { %>
          <p class="hint" style="color: #0a7; font-weight: bold;">Aplicação foi atualizada. Faça login novamente.</p>
        <% } %>
        <p class="hint"><strong>Novas contas:</strong> Após criar a conta, você será enviado para a página do QR Code. É obrigatório escanear o QR Code para vincular seu número ao seu usuário no banco de dados. Só depois disso você poderá acessar a página Configuração.</p>
        <% if (typeof error !== 'undefined' && error) { %>
          <p class="error"><%= error %></p>
        <% } %>
        <form method="post" action="/login" class="form">
          <label>
            Usuário
            <input type="text" name="username" required autocomplete="username">
          </label>
          <label>
            Senha
            <input type="password" name="password" required autocomplete="current-password">
          </label>
          <button type="submit">Entrar</button>
        </form>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem;">
          <button id="show-register" class="btn">Criar conta</button>
          <button id="show-recover" class="btn btn-warning">Esqueci minha senha</button>
        </div>

        <div id="register-box" style="margin-top:0.75rem;">
          <p class="hint">Não tem conta? Registre-se abaixo (primeiro usuário será criado como admin).</p>
          <form id="register-form" class="form inline">
            <input type="text" name="username" placeholder="Novo usuário" required>
            <input type="password" name="password" placeholder="Senha" required>
            <button type="submit">Registrar</button>
          </form>
        </div>

        <div id="recover-box" style="display:none;margin-top:0.75rem;">
          <p class="hint">Recupera sua senha através do QR Code</p>
          <a href="/password-reset/qrcode-recover" class="btn btn-warning" style="display:inline-block;text-decoration:none;padding:0.75rem 1.5rem;font-weight:bold;">Recuperar via QR Code</a>
          <div id="reset-result" style="margin-top:0.75rem;"></div>
        </div>
      </div>
    </main>
  </div>
  <script>
    // Loading overlay functions
    function showLoadingOverlay() {
      const overlay = document.getElementById('loading-overlay');
      if (overlay) {
        overlay.classList.remove('hidden');
      }
    }

    function hideLoadingOverlay() {
      const overlay = document.getElementById('loading-overlay');
      if (overlay) {
        overlay.classList.add('hidden');
      }
    }

    // Hide loading overlay on page load
    window.addEventListener('load', hideLoadingOverlay);
    setTimeout(hideLoadingOverlay, 1000);

    // Login form submission with loading overlay
    document.querySelector('form[action="/login"]').addEventListener('submit', (e) => {
      showLoadingOverlay();
    });

    document.getElementById('register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      showLoadingOverlay();
      const form = e.target;
      const res = await fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: form.username.value,
          password: form.password.value,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok) window.location.href = '/qrcode';
      else if (res.status === 0 || res.type === 'error') {
        hideLoadingOverlay();
        alert('Não foi possível conectar ao servidor.\n\n• Use na barra de endereço: http://localhost:<%= typeof port !== "undefined" ? port : 3000 %>\n• Confira se o app está rodando (npm start no terminal).');
      }
      else {
        hideLoadingOverlay();
        alert(data.error || 'Erro ao registrar');
      }
    });

    // Toggle between register and recover boxes
    const showRegisterBtn = document.getElementById('show-register');
    const showRecoverBtn = document.getElementById('show-recover');
    const registerBox = document.getElementById('register-box');
    const recoverBox = document.getElementById('recover-box');
    showRegisterBtn.addEventListener('click', (e) => { e.preventDefault(); registerBox.style.display = 'block'; recoverBox.style.display = 'none'; });
    showRecoverBtn.addEventListener('click', (e) => { e.preventDefault(); registerBox.style.display = 'none'; recoverBox.style.display = 'block'; });
  </script>
</body>
</html>
